{
  "FileLogging": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MonitoringDashboard;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "MonitoringThresholds": {
    "CpuUsage": 80,
    "MemoryUsage": 90,
    "DiskUsage": 90
  },
  "Jobs": {
    "MetricsCollectionIntervalMinutes": 1
  },
  "Reports": {
    "Directory": "reports"
  },
  "Jwt": {
    "Secret": "local-development-only-signing-key-replace-in-production",
    "Issuer": "MonitoringDashboard",
    "Audience": "MonitoringDashboard.Client",
    "ExpirationMinutes": 60
  }
}